[Unit]
Description=Timosheeto work log web UI (port 8090)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hamza
WorkingDirectory=/home/hamza/redmine-sync
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u /home/hamza/redmine-sync/web.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
